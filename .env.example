# Copia este archivo como .env y completa los valores (NO subas .env al repositorio)
PORT=3000
# Ruta del archivo SQLite
DB_PATH=./data/catalogo.db
# Secreto para firmar los JWT: usa una cadena larga y aleatoria
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
# Vigencia del token (formato de jsonwebtoken: 15m, 1h, 1d)
JWT_EXPIRES_IN=1h
# Credenciales del administrador inicial (se usan solo en: npm run init-admin)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@ejemplo.com
# Si la clave contiene el carácter #, escríbela entre comillas: ADMIN_PASSWORD="Clave#Segura1"
ADMIN_PASSWORD=cambia-esta-clave-admin
