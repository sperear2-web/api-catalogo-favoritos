{
  "name": "api-catalogo-favoritos",
  "version": "1.0.0",
  "description": "API REST de catálogo de productos y favoritos con Node.js, Express, SQLite, JWT y roles",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "init-admin": "node src/db/init-admin.js",
    "setup": "npm run seed && npm run init-admin",
    "test": "node --test tests/api.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2"
  }
}
